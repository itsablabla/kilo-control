# Kilo API token (JWT) - required. Get from app.kilo.ai profile page.
KILO_API_TOKEN=eyJhbGciOi...

# Password that gates access to the app (required).
APP_PASSWORD=change-me

# Optional: separate HMAC secret for session cookie signing.
# Defaults to APP_PASSWORD if unset.
# APP_SESSION_SECRET=some-long-random-string

# Optional: override Kilo API base URL.
# KILO_API_BASE=https://api.kilo.ai
